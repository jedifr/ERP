# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
# Ajouter l'IP LAN et/ou le nom DNS de votre NAS, ex : 192.168.1.50,mon-nas.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Nécessaire uniquement si l'ERP est servi via un reverse proxy HTTPS (ex. le
# reverse proxy Synology DSM). Lister la ou les origines HTTPS utilisées par le
# navigateur, avec le port si non standard, ex : https://192.168.1.50:441
DJANGO_CSRF_TRUSTED_ORIGINS=

# Fichiers déposés (DXF/DWG, app decoupe) servis directement par Django par défaut (true).
# Mettre à false si un reverse proxy dédié prend le relai pour /media/.
DJANGO_SERVE_MEDIA=true

DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=erp_dev_password
# En local (sans Docker) : localhost. Avec docker-compose : surchargé automatiquement à "db".
DB_HOST=localhost
DB_PORT=5432

# Port publié sur l'hôte par docker-compose (voir docker-compose.yml)
ERP_PORT=8000

# Durée d'une session de connexion, en heures (par défaut 12).
DJANGO_SESSION_HEURES=12

# À activer (true) uniquement quand l'ERP est servi en HTTPS via un reverse proxy : les cookies
# de session ne sont alors envoyés que sur HTTPS. En HTTP simple, laisser à false.
DJANGO_COOKIES_SECURISES=false
# HSTS (secondes) : 0 = désactivé ; 31536000 (1 an) une fois le HTTPS validé.
DJANGO_HSTS_SECONDS=0

# E-mail : relances de paiement et synthèse quotidienne. Tant que DJANGO_EMAIL_HOST est vide, les
# messages sont écrits dans les journaux (docker compose logs web) au lieu d'être envoyés.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_TLS=true
DJANGO_EMAIL_EXPEDITEUR=erp@votre-domaine.fr
# Destinataires de la synthèse quotidienne (séparés par des virgules).
DJANGO_SYNTHESE_DESTINATAIRES=
# Délai minimal entre deux relances d'une même facture, en jours.
DJANGO_RELANCE_DELAI_MIN_JOURS=7
