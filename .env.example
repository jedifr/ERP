DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
# Ajouter l'IP LAN et/ou le nom DNS de votre NAS, ex : 192.168.1.50,mon-nas.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Nécessaire uniquement si l'ERP est servi via un reverse proxy HTTPS (ex. le
# reverse proxy Synology DSM). Lister la ou les origines HTTPS utilisées par le
# navigateur, avec le port si non standard, ex : https://192.168.1.50:441
DJANGO_CSRF_TRUSTED_ORIGINS=

# Fichiers déposés (DXF/DWG, app decoupe) servis directement par Django par défaut (true).
# Mettre à false si un reverse proxy dédié prend le relai pour /media/.
DJANGO_SERVE_MEDIA=true

DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=erp_dev_password
# En local (sans Docker) : localhost. Avec docker-compose : surchargé automatiquement à "db".
DB_HOST=localhost
DB_PORT=5432

# Port publié sur l'hôte par docker-compose (voir docker-compose.yml)
ERP_PORT=8000
