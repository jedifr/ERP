DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En prod (DEBUG=False), à compléter avec l'IP/le nom d'hôte réel utilisé pour accéder à
# l'ERP, ex. sur un NAS : DJANGO_ALLOWED_HOSTS=192.168.1.50,mon-nas.local
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.50:8000

DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=erp_dev_password
DB_HOST=localhost
DB_PORT=5432

# Port publié sur l'hôte par docker-compose (voir docker-compose.yml)
ERP_PORT=8000
