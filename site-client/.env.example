# Adresse de l'ERP vue depuis ce serveur : tunnel sortant (Cloudflare Tunnel, Tailscale) ou réseau privé, jamais le NAS ouvert sur Internet.
ERP_URL=http://erp.interne:8000
# Même valeur que ERP_WEB_CLE_API dans le .env de l'ERP.
ERP_WEB_CLE_API=
PORT=3000
# Calculs de prix et envois de panier par visiteur et par minute.
DEBIT_PAR_MINUTE=60
# 1 si un reverse proxy (HTTPS) placé devant transmet l'adresse du visiteur dans X-Forwarded-For.
CONFIANCE_PROXY=0
# Adresse affichée pour les demandes de devis (fichier DXF, forme hors catalogue).
CONTACT_EMAIL=
